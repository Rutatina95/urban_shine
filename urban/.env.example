# Public Base44 app identifier from the Base44 dashboard.
VITE_BASE44_APP_ID=your_base44_app_id

# Base44 app URL used for auth redirects and the local API proxy.
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Optional: set only when you need to pin a specific Base44 functions version.
# VITE_BASE44_FUNCTIONS_VERSION=